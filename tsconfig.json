{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "ES2022",
    "noImplicitAny": true,
    "moduleResolution": "Node",
    "sourceMap": true,
    // "types": ["vitest/globals"],
    "skipLibCheck": true,
    "rootDir": ".",
    "strict": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
    "@Shared/*": [
      "src/Contexts/Shared/*"
    ],
    "@QuidCoreBackend/*": [
      "src/apps/QuidCoreBackend/*"
    ],
  },
  },
  "include": [
    "src/**/**.ts",
    "tests/**/**.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}