{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "ES2022",
    "noImplicitAny": true,
    "moduleResolution": "Node",
    "sourceMap": true,
    "types": [
      "vitest/globals"
    ],
    "skipLibCheck": true,
    "rootDir": ".",
    "strict": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@Shared/*": [
        "src/Contexts/Shared/*"
      ],
      "@Apps/*": [
        "src/apps/*"
      ],
      "@Tests/*": [
        "tests/*"
      ],
      "@Core/*": [
        "src/Contexts/Core/*"
      ],
      "@Events/*": [
        "src/Contexts/Events/*"
      ],
      "@Course/*": [
        "src/Contexts/Course/*"
      ],
      "@Posts/*": [
        "src/Contexts/Posts/*"
      ],
      "@Marketplace/*": [
        "src/Contexts/Marketplace/*"
      ],
      "@Chat/*": [
        "src/Contexts/Chat/*"
      ],
      "@Projects/*": [
        "src/Contexts/Projects/*"
      ],
      "@Media/*": [
        "src/Contexts/Media/*"
      ],
      "@Threads/*": [
        "src/Contexts/Threads/*"
      ],
      "@Stripe/*": [
        "src/Contexts/Stripe/*"
      ],
      "@Auth/*": [
        "src/Contexts/Auth/*"
      ],
       "@Metrics/*": [
        "src/Contexts/Metrics/*"
      ],
    }
  },
  "include": [
    "src/**/**.ts",
    "tests/**/**.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}