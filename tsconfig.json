{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "ES2022",
    "noImplicitAny": true,
    "moduleResolution": "Node",
    "sourceMap": true,
    "types": ["vitest/globals"],
    "skipLibCheck": true,
    "rootDir": ".",
    "strict": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
    "@Shared/*": [
      "src/Contexts/Shared/*"
    ],
    "@Apps/*": [
      "src/apps/*"
    ],
    "@Tests/*": [
      "tests/*"
    ],
    "@Core/*": [
      "src/Contexts/Core/*"
    ],
    "@Posts/*": [
      "src/Contexts/Posts/*"
    ],
    "@Stripe/*": [
      "src/Contexts/Stripe/*"
    ],
    "@Auth/*": [
      "src/Contexts/Auth/*"
    ],
  },
  },
  "include": [
    "src/**/**.ts",
    "tests/**/**.ts"
    ],
  "exclude": [
    "node_modules"
  ]
}