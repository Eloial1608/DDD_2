  "scripts": {
    "lint": "eslint src/* tests/* --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix --no-error-on-unmatched-pattern",
    "test": "npm run test:unit",
    "test:unit": "vitest",
    "migrations:core:generate": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:generate persistence/migrations/core/core -d src/apps/Core/backend/dataSource -o",
    "migrations:core:run": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d src/apps/Core/backend/dataSource",
    "migrations:core:revert": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d src/apps/Core/backend/dataSource",
    "migrations:core:generate:windows": "ts-node -r tsconfig-paths/register node_modules\\typeorm\\cli.js migration:generate persistence/migrations/core/core -d src/apps/Core/backend/dataSource -o",
    "migrations:core:run:windows": "ts-node -r tsconfig-paths/register node_modules\\typeorm\\cli.js migration:run -d src/apps/Core/backend/dataSource",
    "migrations:core:revert:windows": "ts-node -r tsconfig-paths/register node_modules\\typeorm\\cli.js migration:revert -d src/apps/Core/backend/dataSource"
  },
